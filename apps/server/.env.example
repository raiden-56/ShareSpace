# PostgreSQL connection (docker compose exposes the database on port 5433)
DATABASE_URL="postgresql://sharespace:sharespace@localhost:5433/sharespace?schema=public"
# API port (the Vite dev server proxies /api to this port)
PORT=4100
# Public URL of the web app, used to build invitation and password-reset links
APP_URL="http://localhost:5180"
# development | production. In production cookies are Secure and reset links are never logged.
NODE_ENV=development
# Directory for private receipt storage (never served statically)
STORAGE_DIR="./storage"
# Session lifetime in days
SESSION_TTL_DAYS=30
